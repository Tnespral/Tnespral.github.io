---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BpmMeasurementConsole from "../../components/BpmMeasurementConsole.astro";
import BpmMotionPrinciple from "../../components/BpmMotionPrinciple.astro";
import BpmInstrumentSystem from "../../components/BpmInstrumentSystem.astro";
import ExpandableDiagram from "../../components/ExpandableDiagram.astro";
import { Image } from "astro:assets";
import sensusTeam from "../../assets/sensus-2025-team.jpeg";
import { biosensingCopy } from "../../content/site";
---

<BaseLayout
  title="Biosensing by Particle Motion — Tiago Fernández-Nespral"
  description="A responsive control and analysis application that turns live microscopy into a particle-motion biosensing signal."
>
  <div class="site-shell project-shell biosensing-page">
    <div class="project-layout">
      <aside class="project-sidebar">
        <div class="sidebar-sticky">
          <a class="back-link" href="/">← Back to projects</a>
          <details class="contents" open data-contents>
            <summary>
              <span>Contents</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
            </summary>
            <nav class="chapter-rail" aria-label="Project contents">
              <ol>
                <li><a href="#principle" data-progress-link><span>Problem</span><i></i></a></li>
                <li><a href="#system" data-progress-link><span>Instrument</span><i></i></a></li>
                <li><a href="#implementation" data-progress-link><span>Implementation</span><i></i></a></li>
                <li><a href="#result" data-progress-link><span>SensUs 2025</span><i></i></a></li>
              </ol>
            </nav>
          </details>
        </div>
      </aside>

      <article>
        <section id="principle" class="chapter opening" data-chapter>
          <header class="project-heading">
            <p class="project-meta mono">
              <span>{biosensingCopy.meta.year}</span>
              <a href={biosensingCopy.meta.repository}>View repository ↗</a>
              <a href={biosensingCopy.meta.teamSite}>T.E.S.T. website ↗</a>
            </p>
            <h1>{biosensingCopy.meta.title}</h1>
            <p class="lead">{biosensingCopy.introduction}</p>
          </header>

          <div class="section-intro opening-section">
            <h2>{biosensingCopy.principle.title}</h2>
            {biosensingCopy.principle.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <BpmMotionPrinciple />
        </section>

        <section id="system" class="chapter" data-chapter>
          <div class="section-intro">
            <h2>{biosensingCopy.system.title}</h2>
            <p>{biosensingCopy.system.body}</p>
          </div>
          <ExpandableDiagram label="Fluidics and optics system">
            <BpmInstrumentSystem />
          </ExpandableDiagram>

          <div class="instrument-notes">
            <section aria-labelledby="fluidics-title">
              <h3 id="fluidics-title">{biosensingCopy.system.fluidicsTitle}</h3>
              {biosensingCopy.system.fluidicsBody.map((paragraph) => <p>{paragraph}</p>)}
            </section>
            <section aria-labelledby="optics-title">
              <h3 id="optics-title">{biosensingCopy.system.opticsTitle}</h3>
              <p>{biosensingCopy.system.opticsBody}</p>
            </section>
          </div>
        </section>

        <section id="implementation" class="chapter" data-chapter>
          <div class="section-intro">
            <h2>{biosensingCopy.application.title}</h2>
            {biosensingCopy.application.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <BpmMeasurementConsole />
          <p class="calibration-note">
            <span class="mono">Calibration</span>
            <span>{biosensingCopy.application.calibration}</span>
          </p>
        </section>

        <section id="result" class="chapter final-chapter" data-chapter>
          <div class="section-intro">
            <h2>{biosensingCopy.result.title}</h2>
            <p>{biosensingCopy.result.body}</p>
          </div>

          <dl class="competition-awards" aria-label="T.E.S.T. awards at SensUs 2025">
            {biosensingCopy.result.awards.map((award) => (
              <div><dt>{award.place}</dt><dd>{award.award}</dd></div>
            ))}
          </dl>

          <figure class="competition-photo">
            <Image
              src={sensusTeam}
              alt="The T.E.S.T. team together at SensUs 2025 with its trophy and Translation Potential award."
              width={2200}
              quality={84}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <footer class="closing">
            <div class="closing-links">
              <a href={biosensingCopy.meta.repository}>View repository ↗</a>
              <a href={biosensingCopy.meta.teamSite}>T.E.S.T. website ↗</a>
              <a href="/">Back to projects</a>
            </div>
            <p class="credit">{biosensingCopy.credit}</p>
          </footer>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-progress-link]")];
  const setActive = (id: string) => links.forEach((link) => link.toggleAttribute("aria-current", link.hash === `#${id}`));
  let scrollFrame = 0;
  const updateActiveChapter = () => {
    const marker = window.innerHeight * 0.3;
    const active = chapters.reduce((current, chapter) => (chapter.getBoundingClientRect().top <= marker ? chapter : current), chapters[0]);
    if (active?.id) setActive(active.id);
    scrollFrame = 0;
  };
  const scheduleChapterUpdate = () => {
    if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateActiveChapter);
  };
  window.addEventListener("scroll", scheduleChapterUpdate, { passive: true });
  window.addEventListener("resize", scheduleChapterUpdate);
  updateActiveChapter();

  const contents = document.querySelector<HTMLDetailsElement>("[data-contents]");
  const compactLayout = window.matchMedia("(max-width: 58rem)");
  if (contents && compactLayout.matches) contents.open = false;
  links.forEach((link) => link.addEventListener("click", () => {
    setActive(link.hash.slice(1));
    if (contents && compactLayout.matches) contents.open = false;
  }));
</script>

<style>
  .biosensing-page { --page-accent: #8b665e; }
  .project-shell { width: min(calc(100% - 2rem), 68rem); padding-block: 0.75rem 3.25rem; }
  .project-layout { display: grid; grid-template-columns: 9rem minmax(0, var(--prose)); gap: clamp(2.5rem, 6vw, 5rem); margin-top: 1.25rem; }
  .sidebar-sticky { position: sticky; top: 1rem; display: grid; gap: 0.65rem; }
  .back-link { display: inline-flex; min-height: 2.25rem; align-items: center; color: var(--muted); font-size: 0.72rem; text-decoration: none; white-space: nowrap; }
  .contents { padding-top: 0.75rem; border-top: 1px solid var(--border); }
  .contents summary { display: flex; min-height: 2rem; align-items: center; justify-content: space-between; gap: 0.75rem; color: var(--foreground); cursor: pointer; font-family: "IBM Plex Mono Variable", monospace; font-size: 0.67rem; font-weight: 500; list-style: none; text-transform: uppercase; }
  .contents summary::-webkit-details-marker { display: none; }
  .contents summary svg { width: 0.85rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; transition: transform 180ms ease; }
  .contents[open] summary svg { transform: rotate(180deg); }
  .chapter-rail { margin-top: 0.55rem; }
  .chapter-rail ol { display: grid; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .chapter-rail a { display: grid; grid-template-columns: auto minmax(1.2rem, 1fr); align-items: center; gap: 0.65rem; min-height: 1.9rem; color: var(--muted); font-family: "IBM Plex Mono Variable", monospace; font-size: 0.64rem; line-height: 1.25; text-decoration: none; }
  .chapter-rail i { height: 1px; background: var(--border); transform: scaleX(0.78); transform-origin: left; transition: background-color 180ms ease, transform 180ms ease; }
  .chapter-rail a[aria-current] { color: var(--page-accent); }
  .chapter-rail a[aria-current] i { background: var(--page-accent); transform: scaleX(1); }

  article { min-width: 0; max-width: var(--prose); }
  .chapter { scroll-margin-top: 1rem; padding-block: clamp(2.3rem, 4vw, 3.25rem); border-bottom: 1px solid var(--border); }
  .chapter:last-child { border-bottom: 0; }
  .opening { padding-top: 0.5rem; }
  .project-meta { display: flex; gap: 1.5rem; margin-bottom: 1.15rem; color: var(--muted); font-size: var(--text-label); text-transform: uppercase; }
  .project-heading h1 { margin-bottom: 1rem; font-size: 1.75rem; }
  .lead,
  .section-intro p,
  .instrument-notes p,
  .calibration-note,
  .credit { margin-bottom: 0; color: var(--muted); font-size: var(--text-reading); line-height: var(--reading-line-height); }
  .section-intro { margin-bottom: 1.45rem; }
  .section-intro h2 { margin-bottom: 0.9rem; font-size: 2rem; }
  .section-intro p + p { margin-top: 0.8rem; }
  .opening-section { margin-top: 2.5rem; }

  .instrument-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.7rem; }
  .instrument-notes section { padding-top: 1rem; border-top: 1px solid var(--border); }
  .instrument-notes h3 { margin-bottom: 0.65rem; font-size: 1.22rem; }
  .instrument-notes p + p { margin-top: 0.8rem; }

  .calibration-note { display: grid; grid-template-columns: 5.4rem minmax(0, 1fr); gap: 1rem; margin-top: 1.25rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .calibration-note > span:first-child { padding-top: 0.12rem; color: var(--page-accent); font-size: 0.62rem; text-transform: uppercase; }

  .competition-awards { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: color-mix(in srgb, var(--surface) 70%, var(--background)); }
  .competition-awards div { display: grid; align-content: center; gap: 0.28rem; min-width: 0; padding: 0.95rem 1rem; }
  .competition-awards div + div { border-left: 1px solid var(--border); }
  .competition-awards dt { color: var(--page-accent); font-family: "IBM Plex Mono Variable", monospace; font-size: 0.52rem; text-transform: uppercase; }
  .competition-awards dd { margin: 0; color: var(--foreground); font-size: 0.72rem; font-weight: 610; line-height: 1.35; }
  .competition-photo { margin: 1rem 0 0; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .competition-photo img { display: block; width: 100%; height: auto; }
  .final-chapter { padding-bottom: 0; }
  .closing { margin-top: 2.3rem; padding-top: 1.3rem; border-top: 1px solid var(--border); }
  .closing-links { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.82rem; }
  .credit { margin-top: 1.15rem; font-size: var(--text-caption); }

  @media (max-width: 58rem) {
    .project-shell { width: min(calc(100% - 2rem), var(--prose)); }
    .project-layout { grid-template-columns: 1fr; gap: 1.1rem; margin-top: 0; }
    .project-sidebar { border-bottom: 1px solid var(--border); }
    .sidebar-sticky { position: static; grid-template-columns: 1fr auto; align-items: start; }
    .contents { min-width: 10rem; padding-top: 0; border-top: 0; }
    .chapter-rail { position: absolute; z-index: 10; right: 1rem; width: min(15rem, calc(100vw - 2rem)); padding: 0.7rem; border: 1px solid var(--border); border-radius: 0.65rem; background: var(--background); box-shadow: var(--shadow); }
  }

  @media (max-width: 42rem) {
    .instrument-notes { grid-template-columns: 1fr; }
    .competition-awards { grid-template-columns: 1fr; }
    .competition-awards div + div { border-top: 1px solid var(--border); border-left: 0; }
  }

  @media (max-width: 32rem) {
    .calibration-note { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
