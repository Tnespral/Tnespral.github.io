---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BurglaryDataTransform from "../../components/BurglaryDataTransform.astro";
import BurglaryFeatureAtlas from "../../components/BurglaryFeatureAtlas.astro";
import BurglaryResults from "../../components/BurglaryResults.astro";
import BurglaryTemporalModel from "../../components/BurglaryTemporalModel.astro";
import { burglaryCopy } from "../../content/site";
---

<BaseLayout
  title="Forecasting burglary hotspots in London — Tiago Fernández-Nespral"
  description="A ConvLSTM that forecasts which 500 m areas of London are most likely to record a residential burglary next month."
>
  <div class="site-shell project-shell burglary-page">
    <div class="project-layout">
      <aside class="project-sidebar">
        <div class="sidebar-sticky">
          <a class="back-link" href="/">← Back to projects</a>
          <details class="contents" open data-contents>
            <summary>
              <span>Contents</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
            </summary>
            <nav class="chapter-rail" aria-label="Project contents">
              <ol>
                <li><a href="#problem" data-progress-link><span>Problem</span><i></i></a></li>
                <li><a href="#inputs" data-progress-link><span>Inputs</span><i></i></a></li>
                <li><a href="#model" data-progress-link><span>Model</span><i></i></a></li>
                <li><a href="#evaluation" data-progress-link><span>Evaluation</span><i></i></a></li>
              </ol>
            </nav>
          </details>
        </div>
      </aside>

      <article>
        <section id="problem" class="chapter opening" data-chapter>
          <header class="project-heading">
            <p class="project-meta mono">
              <span>{burglaryCopy.meta.year}</span>
              <a href={burglaryCopy.meta.repository}>View repository ↗</a>
            </p>
            <h1>{burglaryCopy.meta.title}</h1>
            <p class="lead">{burglaryCopy.introduction}</p>
          </header>

          <div class="section-intro first-section">
            <h2>{burglaryCopy.problem.title}</h2>
            <p>{burglaryCopy.problem.body}</p>
          </div>
          <BurglaryDataTransform />
          <p class="figure-follow">{burglaryCopy.problem.figureBody}</p>
        </section>

        <section id="inputs" class="chapter" data-chapter>
          <div class="section-intro">
            <h2>{burglaryCopy.inputs.title}</h2>
            <p>{burglaryCopy.inputs.body}</p>
          </div>
          <BurglaryFeatureAtlas />
          <p class="technical-note">{burglaryCopy.inputs.note}</p>
        </section>

        <section id="model" class="chapter" data-chapter>
          <div class="section-intro">
            <h2>{burglaryCopy.model.title}</h2>
            <p>{burglaryCopy.model.body}</p>
          </div>
          <BurglaryTemporalModel />
          <p class="technical-note">{burglaryCopy.model.loss}</p>
        </section>

        <section id="evaluation" class="chapter final-chapter" data-chapter>
          <div class="section-intro">
            <h2>{burglaryCopy.evaluation.title}</h2>
            <p>{burglaryCopy.evaluation.body}</p>
          </div>
          <BurglaryResults />
          <p class="result-conclusion">{burglaryCopy.evaluation.conclusion}</p>

          <div class="subsection-heading final-note">
            <h3>{burglaryCopy.evaluation.limitsTitle}</h3>
            <p>{burglaryCopy.evaluation.limitsBody}</p>
          </div>

          <footer class="closing">
            <div class="closing-links">
              <a href={burglaryCopy.meta.repository}>View repository ↗</a>
              <a href="/">Back to projects</a>
            </div>
            <p class="credit">{burglaryCopy.credit}</p>
          </footer>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-progress-link]")];
  const setActive = (id: string) => links.forEach((link) => link.toggleAttribute("aria-current", link.hash === "#" + id));
  let scrollFrame = 0;
  const updateActiveChapter = () => {
    const marker = window.innerHeight * 0.3;
    const active = chapters.reduce((current, chapter) => (chapter.getBoundingClientRect().top <= marker ? chapter : current), chapters[0]);
    if (active?.id) setActive(active.id);
    scrollFrame = 0;
  };
  const scheduleChapterUpdate = () => {
    if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateActiveChapter);
  };
  window.addEventListener("scroll", scheduleChapterUpdate, { passive: true });
  window.addEventListener("resize", scheduleChapterUpdate);
  updateActiveChapter();
  const contents = document.querySelector<HTMLDetailsElement>("[data-contents]");
  const compactLayout = window.matchMedia("(max-width: 58rem)");
  if (contents && compactLayout.matches) contents.open = false;
  links.forEach((link) => link.addEventListener("click", () => {
    setActive(link.hash.slice(1));
    if (contents && compactLayout.matches) contents.open = false;
  }));
</script>

<style>
  .burglary-page { --page-accent: #9a735b; }
  .project-shell { width: min(calc(100% - 2rem), 68rem); padding-block: 0.75rem 3.25rem; }
  .project-layout { display: grid; grid-template-columns: 9rem minmax(0, var(--prose)); gap: clamp(2.5rem, 6vw, 5rem); margin-top: 1.25rem; }
  .sidebar-sticky { position: sticky; top: 1rem; display: grid; gap: 0.65rem; }
  .back-link { display: inline-flex; min-height: 2.25rem; align-items: center; color: var(--muted); font-size: 0.72rem; text-decoration: none; white-space: nowrap; }
  .contents { padding-top: 0.75rem; border-top: 1px solid var(--border); }
  .contents summary { display: flex; min-height: 2rem; align-items: center; justify-content: space-between; gap: 0.75rem; color: var(--foreground); cursor: pointer; font-family: "IBM Plex Mono Variable", monospace; font-size: 0.67rem; font-weight: 500; list-style: none; text-transform: uppercase; }
  .contents summary::-webkit-details-marker { display: none; }
  .contents summary svg { width: 0.85rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; transition: transform 180ms ease; }
  .contents[open] summary svg { transform: rotate(180deg); }
  .chapter-rail { margin-top: 0.55rem; }
  .chapter-rail ol { display: grid; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .chapter-rail a { display: grid; grid-template-columns: auto minmax(1.2rem, 1fr); align-items: center; gap: 0.65rem; min-height: 1.9rem; color: var(--muted); font-family: "IBM Plex Mono Variable", monospace; font-size: 0.64rem; line-height: 1.25; text-decoration: none; }
  .chapter-rail i { height: 1px; background: var(--border); transform: scaleX(0.78); transform-origin: left; transition: background-color 180ms ease, transform 180ms ease; }
  .chapter-rail a[aria-current] { color: var(--page-accent); }
  .chapter-rail a[aria-current] i { background: var(--page-accent); transform: scaleX(1); }
  article { min-width: 0; max-width: var(--prose); }
  .chapter { scroll-margin-top: 1rem; padding-block: clamp(2.4rem, 4vw, 3.3rem); border-bottom: 1px solid var(--border); }
  .chapter:last-child { border-bottom: 0; }
  .opening { padding-top: 0.5rem; }
  .project-meta { display: flex; gap: 1.5rem; margin-bottom: 1.15rem; color: var(--muted); font-size: var(--text-label); text-transform: uppercase; }
  .project-heading h1 { margin-bottom: 1rem; font-size: 1.75rem; }
  .lead, .section-intro p, .subsection-heading p, .figure-follow, .technical-note, .result-conclusion, .credit { margin-bottom: 0; color: var(--muted); font-size: var(--text-reading); line-height: var(--reading-line-height); }
  .section-intro { margin-bottom: 1.4rem; }
  .section-intro h2 { margin-bottom: 0.85rem; font-size: 2rem; }
  .first-section { margin-top: 2.5rem; }
  .figure-follow, .technical-note, .result-conclusion { margin-top: 1rem; }
  .technical-note { padding-left: 0.85rem; border-left: 2px solid color-mix(in srgb, var(--page-accent) 56%, var(--border)); }
  .subsection-heading { margin-top: 2.4rem; padding-top: 1.8rem; border-top: 1px solid var(--border); }
  .subsection-heading h3 { margin-bottom: 0.7rem; font-size: 1.25rem; }
  .final-note { margin-top: 2.2rem; }
  .final-chapter { padding-bottom: 0; }
  .closing { margin-top: 2.5rem; padding-top: 1.4rem; border-top: 1px solid var(--border); }
  .closing-links { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.82rem; }
  .credit { margin-top: 1.15rem; font-size: var(--text-caption); }
  @media (max-width: 58rem) {
    .project-shell { width: min(calc(100% - 2rem), var(--prose)); }
    .project-layout { grid-template-columns: 1fr; gap: 1.1rem; margin-top: 0; }
    .project-sidebar { border-bottom: 1px solid var(--border); }
    .sidebar-sticky { position: static; grid-template-columns: 1fr auto; align-items: start; }
    .contents { min-width: 10rem; padding-top: 0; border-top: 0; }
    .chapter-rail { position: absolute; z-index: 10; right: 1rem; width: min(15rem, calc(100vw - 2rem)); padding: 0.7rem; border: 1px solid var(--border); border-radius: 0.65rem; background: var(--background); box-shadow: var(--shadow); }
  }
</style>
