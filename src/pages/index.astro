---
import BaseLayout from "../layouts/BaseLayout.astro";
import BiosensingPreview from "../components/BiosensingPreview.astro";
import BurglaryPreview from "../components/BurglaryPreview.astro";
import PorousPreview from "../components/PorousPreview.astro";
import AirlinePreview from "../components/AirlinePreview.astro";
import { homeCopy } from "../content/site";
import { projects } from "../data/projects";

const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
const monthIndex = (month?: string) => (month ? months.indexOf(month) : -1);
const published = projects
  .filter((project) => project.published)
  .sort((a, b) => b.year - a.year || monthIndex(b.month) - monthIndex(a.month));
---

<BaseLayout>
  <div class="site-shell home">
    <section class="introduction" aria-labelledby="intro-title">
      <div class="portrait-placeholder" aria-label="Portrait placeholder">
        <span>Photo<br />TBD</span>
      </div>
      <div>
        <h1 id="intro-title">{homeCopy.title}</h1>
        <p>{homeCopy.introduction}</p>
      </div>
    </section>

    <section class="projects" aria-labelledby="projects-title">
      <div class="projects-heading">
        <h2 id="projects-title">Projects</h2>
        <label class="project-sort mono">
          <select data-project-sort aria-label="Sort projects by date">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
          </select>
        </label>
      </div>

      <ol class="project-list">
        {
          published.map((project) => (
            <li data-project-item data-project-date={project.year * 12 + monthIndex(project.month)}>
              <a class="project-card" href={`/projects/${project.slug}/`}>
                <div class="project-copy">
                  <span class="project-year">
                    {project.month ? `${project.month} ${project.year}` : project.year}
                  </span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>
                {project.slug === "coral-bleaching" && (
                  <div class="project-preview" data-project-preview aria-hidden="true">
                    <img
                      class="project-preview-image"
                      src="/images/noaa-coral-bleaching.jpg"
                      alt=""
                      width="1280"
                      height="960"
                    />
                    <span class="magnifier">
                      <img src="/images/magnifier.svg" alt="" width="112" height="112" />
                      <span class="detection-point"></span>
                    </span>
                  </div>
                )}
                {project.slug === "burglary-hotspot-forecasting" && <BurglaryPreview />}
                {project.slug === "biosensing-particle-motion" && <BiosensingPreview />}
                {project.slug === "porous-media-flow" && <PorousPreview />}
                {project.slug === "airline-chatbot" && <AirlinePreview />}
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<script>
  const projectList = document.querySelector<HTMLOListElement>(".project-list");
  const projectSort = document.querySelector<HTMLSelectElement>("[data-project-sort]");
  const projectItems = Array.from(document.querySelectorAll<HTMLElement>("[data-project-item]"));
  const projectOrderKey = "portfolio-project-order";

  const sortProjects = (order: "newest" | "oldest") => {
    const direction = order === "oldest" ? 1 : -1;
    const sortedItems = [...projectItems].sort((first, second) => {
      return direction * (Number(first.dataset.projectDate) - Number(second.dataset.projectDate));
    });

    sortedItems.forEach((item) => projectList?.append(item));
  };

  const savedOrder = sessionStorage.getItem(projectOrderKey);
  if (projectSort && (savedOrder === "newest" || savedOrder === "oldest")) {
    projectSort.value = savedOrder;
    sortProjects(savedOrder);
  }

  projectSort?.addEventListener("change", () => {
    const order = projectSort.value === "oldest" ? "oldest" : "newest";
    sortProjects(order);
    sessionStorage.setItem(projectOrderKey, order);
  });

  const previewQuery = "[data-project-preview]";
  const touchLayout = window.matchMedia("(hover: none), (pointer: coarse)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let previewObserver: IntersectionObserver | undefined;

  const clearPreviewStates = () => {
    document.querySelectorAll<HTMLElement>(".project-card.is-preview-active").forEach((card) => {
      card.classList.remove("is-preview-active");
    });
  };

  const configurePreviewPlayback = () => {
    previewObserver?.disconnect();
    clearPreviewStates();

    if (!touchLayout.matches || reducedMotion.matches) return;

    previewObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const card = entry.target.closest<HTMLElement>(".project-card");
          card?.classList.toggle("is-preview-active", entry.isIntersecting && entry.intersectionRatio >= 0.55);
        });
      },
      { threshold: [0, 0.55, 1] },
    );

    document.querySelectorAll<HTMLElement>(previewQuery).forEach((preview) => previewObserver?.observe(preview));
  };

  configurePreviewPlayback();
  touchLayout.addEventListener("change", configurePreviewPlayback);
  reducedMotion.addEventListener("change", configurePreviewPlayback);
</script>

<style>
  .home {
    padding-block: 2rem 4rem;
  }

  .introduction {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
    min-height: 9rem;
  }

  .portrait-placeholder {
    display: grid;
    width: 5.5rem;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 42% 58% 48% 52% / 48% 38% 62% 52%;
    background:
      radial-gradient(circle at 62% 26%, color-mix(in srgb, var(--coral) 55%, transparent), transparent 28%),
      linear-gradient(145deg, var(--ocean-soft), var(--surface));
    color: var(--ocean);
    font-family: "IBM Plex Mono Variable", monospace;
    font-size: 0.68rem;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
  }

  .introduction h1 {
    margin-bottom: 0.7rem;
    font-size: 1.75rem;
  }

  .introduction p {
    max-width: 41rem;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .projects {
    margin-top: 2.25rem;
  }

  .projects-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .projects-heading h2 {
    margin-bottom: 0;
  }

  .projects-heading h2 {
    font-size: 2rem;
  }

  .project-sort {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin-bottom: 0;
    color: var(--muted);
  }

  .project-sort::after {
    position: absolute;
    right: 0.75rem;
    width: 0.38rem;
    height: 0.38rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    pointer-events: none;
    content: "";
    transform: translateY(-0.12rem) rotate(45deg);
  }

  .project-sort select {
    appearance: none;
    width: 8.4rem;
    min-height: 2.15rem;
    padding: 0.45rem 2.1rem 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--background);
    color: inherit;
    font: inherit;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .project-sort select:hover,
  .project-sort select:focus-visible {
    border-color: var(--muted);
    color: var(--foreground);
  }

  .project-sort select:focus-visible {
    outline: 2px solid var(--ocean);
    outline-offset: 2px;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 10rem;
    gap: 1.5rem;
    align-items: center;
    min-height: 0;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
    text-decoration: none;
  }

  .project-copy {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    column-gap: 1rem;
  }

  .project-year {
    grid-row: 1 / span 2;
    padding-top: 0.45rem;
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .project-copy h3 {
    position: relative;
    width: fit-content;
    margin-bottom: 0.25rem;
    font-size: 1rem;
  }

  .project-copy h3::after {
    position: absolute;
    right: 0;
    bottom: -0.18rem;
    left: 0;
    height: 0.12rem;
    background: var(--ocean);
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms ease;
  }

  .project-copy p {
    max-width: 42rem;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .project-preview {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1.75;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .project-preview-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    backface-visibility: hidden;
    transform: translateZ(0) scale(1);
    transform-origin: 50% 50%;
    will-change: transform, filter;
    transition:
      filter 420ms ease,
      transform 620ms cubic-bezier(0.2, 0.82, 0.2, 1);
  }

  .magnifier {
    position: absolute;
    top: 41.2%;
    left: 50.6%;
    width: 35cqw;
    height: 35cqw;
    opacity: 0;
    pointer-events: none;
    transform: translate(110%, -135%) rotate(18deg) scale(0.72);
    transform-origin: 39.3% 39.3%;
    transition:
      opacity 150ms ease,
      transform 620ms cubic-bezier(0.2, 0.82, 0.2, 1);
  }

  .magnifier img {
    position: static;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: none;
    transform: none;
    transition: none;
  }

  .detection-point {
    position: absolute;
    top: 39.3%;
    left: 39.3%;
    z-index: 1;
    width: 69.6%;
    aspect-ratio: 1;
    border: 1.5px solid color-mix(in srgb, var(--coral) 58%, #d9a447);
    border-radius: 50%;
    background: transparent;
    box-shadow: 0 0 0 1px rgb(244 240 231 / 55%);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.06);
  }

  .project-card:hover h3::after,
  .project-card.is-preview-active h3::after,
  .project-card:focus-visible h3::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .project-card:hover .project-preview-image,
  .project-card.is-preview-active .project-preview-image,
  .project-card:focus-visible .project-preview-image {
    filter: saturate(1.08) brightness(1.025);
    transform: translateZ(0) scale(1.025);
  }

  .project-card:hover .magnifier,
  .project-card.is-preview-active .magnifier,
  .project-card:focus-visible .magnifier {
    opacity: 1;
    transform: translate(-39.3%, -39.3%) rotate(0deg) scale(1);
  }

  .project-card:hover .detection-point,
  .project-card.is-preview-active .detection-point,
  .project-card:focus-visible .detection-point {
    animation: detection-pulse 760ms 760ms cubic-bezier(0.16, 0.72, 0.28, 1) both;
  }

  @keyframes detection-pulse {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.06);
    }

    18% {
      opacity: 0.82;
    }

    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detection-point {
      display: none;
    }
  }

  @media (max-width: 50rem) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

  }

  @media (max-width: 36rem) {
    .introduction {
      grid-template-columns: 4.7rem 1fr;
      align-items: start;
    }

    .portrait-placeholder {
      width: 4.7rem;
      font-size: 0.62rem;
    }

    .introduction h1 {
      font-size: 1.75rem;
    }

    .introduction p {
      grid-column: 1 / -1;
    }

    .project-copy {
      grid-template-columns: 1fr;
    }

    .project-year {
      grid-row: auto;
      margin-bottom: 0.6rem;
    }
  }
</style>
