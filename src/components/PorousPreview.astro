  <div class="preview-field"><img src="/figures/porous-media/field-flow.png" alt="" /></div>
  <span class="preview-scan"></span>
</div>

<style>
  .porous-preview {
    --scan-start: 11.25cqw;
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1.75;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #050606;
    box-shadow: var(--shadow);
    isolation: isolate;
  }

