---
import { porousCopy } from "../content/site";

const transforms = [
  { label: "I", css: "none" },
  { label: "H", css: "scaleX(-1)" },
  { label: "V", css: "scaleY(-1)" },
  { label: "R", css: "rotate(180deg)" },
];
---

<figure class="physics-figure">
  <div class="physics-board">
    <article class="constraint scale-card">
      <header>
        <span class="constraint-number mono">01</span>
        <h3>{porousCopy.physics.scaleTitle}</h3>
      </header>
      <div class="scale-diagram" aria-label="Known physical parameters are combined into q zero, which is used to create a dimensionless learning target">
        <div class="parameter-list mono" aria-hidden="true">
          <span>ΔP</span><span>ΔA</span><span>μ</span><span>L</span>
        </div>
        <b aria-hidden="true">→</b>
        <div class="scale-equation">
          <small class="mono">known scale</small>
          <strong>q₀ = <i>ΔP · ΔA</i> / <i>μ · L</i></strong>
        </div>
        <b aria-hidden="true">→</b>
        <div class="scale-target">
          <small class="mono">network target</small>
          <strong>q* = q / q₀</strong>
        </div>
      </div>
      <p>{porousCopy.physics.scaleBody}</p>
    </article>

    <article class="constraint mask-card">
      <header>
        <span class="constraint-number mono">02</span>
        <h3>{porousCopy.physics.maskTitle}</h3>
      </header>
      <div class="mask-diagram" aria-label="The predicted field is multiplied by the porous mask so closed pixels contain exactly zero flow">
        <figure>
          <img src="/figures/porous-media/masking-raw.png" alt="Schematic candidate flow field before physical masking" />
          <figcaption>candidate field</figcaption>
        </figure>
        <b aria-hidden="true">×</b>
        <figure>
          <img class="pixelated" src="/figures/porous-media/masking-mask.png" alt="Binary porous geometry" />
          <figcaption>geometry</figcaption>
        </figure>
        <b aria-hidden="true">=</b>
        <figure class="valid-field">
          <img src="/figures/porous-media/masking-valid.png" alt="Candidate field restricted to open pixels" />
          <figcaption>valid field</figcaption>
        </figure>
      </div>
      <p>{porousCopy.physics.maskBody}</p>
    </article>

    <article class="constraint symmetry-card">
      <header>
        <span class="constraint-number mono">03</span>
        <h3>{porousCopy.physics.symmetryTitle}</h3>
      </header>
      <div class="symmetry-diagram" aria-label="Four valid orientations are evaluated by the same U-Net, aligned and averaged">
        <div class="orientation-set">
          {
            transforms.map((item) => (
              <span>
                <img src="/figures/porous-media/masking-mask.png" alt="" style={`transform:${item.css}`} />
                <i class="mono">{item.label}</i>
              </span>
            ))
          }
        </div>
        <b aria-hidden="true">→</b>
        <div class="shared-model">
          <i></i><i></i><i></i>
          <strong>U-Net</strong>
          <small>shared weights</small>
        </div>
        <b aria-hidden="true">→</b>
        <div class="averaged-field">
          <span class="field-stack" aria-hidden="true"><i></i><i></i><i></i></span>
          <img src="/figures/porous-media/masking-valid.png" alt="Aligned and averaged flow field" />
          <small>align + average</small>
        </div>
      </div>
      <p>{porousCopy.physics.symmetryBody}</p>
      <div class="equivariance-proof">
        <span class="mono">mean equivariance error</span>
        <strong>2.49 × 10<sup>−1</sup></strong>
        <b aria-hidden="true">→</b>
        <strong class="final-value">4.24 × 10<sup>−7</sup></strong>
      </div>
    </article>
  </div>
  <figcaption>{porousCopy.physics.symmetryResult}</figcaption>
</figure>

<style>
  .physics-figure { margin: 0; }
  .physics-board {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 68%, var(--background));
  }
  .constraint { padding: clamp(1rem, 2.4vw, 1.35rem); }
  .constraint + .constraint { border-top: 1px solid var(--border); }
  .constraint header { display: flex; gap: 0.7rem; align-items: baseline; margin-bottom: 1rem; }
  .constraint-number { color: var(--flow-accent); font-size: var(--text-label); }
  .constraint h3 { margin: 0; font-size: 1rem; }
  .constraint > p {
    max-width: 38rem;
    margin: 0.95rem 0 0;
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: 1.65;
  }

  .scale-diagram {
    display: grid;
    grid-template-columns: auto auto minmax(9rem, 1fr) auto minmax(7rem, 0.72fr);
    gap: 0.7rem;
    align-items: center;
  }
  .parameter-list { display: grid; grid-template-columns: repeat(2, 2rem); gap: 0.3rem; }
  .parameter-list span {
    display: grid;
    min-height: 1.7rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    background: var(--background);
    color: var(--muted);
    font-size: 0.62rem;
  }
  .scale-diagram > b,
  .mask-diagram > b,
  .symmetry-diagram > b { color: var(--flow-accent); font-size: 0.85rem; font-weight: 450; }
  .scale-equation,
  .scale-target {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
  }
  .scale-equation small,
  .scale-target small { color: var(--muted); font-size: 0.5rem; text-transform: uppercase; }
  .scale-equation strong,
  .scale-target strong { font-size: clamp(0.82rem, 2vw, 1rem); font-weight: 580; white-space: nowrap; }
  .scale-equation i { font-style: normal; }

  .mask-diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 0.65rem;
    align-items: center;
  }
  .mask-diagram figure { min-width: 0; margin: 0; }
  .mask-diagram img {
    width: 100%;
    aspect-ratio: 2;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .mask-diagram .pixelated { background: #050606; image-rendering: pixelated; }
  .mask-diagram figcaption {
    margin-top: 0.3rem;
    color: var(--muted);
    font-family: "IBM Plex Mono Variable", monospace;
    font-size: 0.52rem;
    text-transform: uppercase;
  }
  .valid-field { position: relative; }

  .symmetry-diagram {
    display: grid;
    grid-template-columns: minmax(10rem, 1.25fr) auto minmax(6.5rem, 0.65fr) auto minmax(7rem, 0.8fr);
    gap: 0.7rem;
    align-items: center;
  }
  .orientation-set { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.35rem; }
  .orientation-set span { display: grid; gap: 0.25rem; justify-items: center; }
  .orientation-set img {
    width: 100%;
    aspect-ratio: 2;
    border: 1px solid var(--border);
    border-radius: 0.28rem;
    background: #050606;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .orientation-set i { color: var(--muted); font-size: 0.48rem; font-style: normal; }
  .shared-model {
    position: relative;
    display: grid;
    min-height: 4.6rem;
    place-content: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--flow-accent) 42%, var(--border));
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--flow-accent) 5%, var(--background));
    text-align: center;
  }
  .shared-model i { position: absolute; inset-block: 0.55rem; width: 1px; background: color-mix(in srgb, var(--flow-accent) 20%, transparent); }
  .shared-model i:nth-child(1) { left: 25%; }
  .shared-model i:nth-child(2) { left: 50%; }
  .shared-model i:nth-child(3) { left: 75%; }
  .shared-model strong,
  .shared-model small { position: relative; z-index: 1; }
  .shared-model strong { font-size: 0.85rem; }
  .shared-model small { margin-top: 0.1rem; color: var(--muted); font-size: 0.48rem; }
  .averaged-field { position: relative; display: grid; gap: 0.3rem; }
  .averaged-field img {
    position: relative;
    z-index: 2;
    width: 100%;
    aspect-ratio: 2;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .averaged-field small { color: var(--muted); font-family: "IBM Plex Mono Variable", monospace; font-size: 0.5rem; }
  .field-stack i {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% - 0.8rem);
    border: 1px solid color-mix(in srgb, var(--flow-accent) 28%, var(--border));
    border-radius: 0.4rem;
    background: var(--surface);
  }
  .field-stack i:nth-child(1) { transform: translate(-0.42rem, -0.42rem); }
  .field-stack i:nth-child(2) { transform: translate(-0.28rem, -0.28rem); }
  .field-stack i:nth-child(3) { transform: translate(-0.14rem, -0.14rem); }
  .equivariance-proof {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    gap: 0.65rem;
    align-items: center;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border);
  }
  .equivariance-proof span { color: var(--muted); font-size: 0.52rem; text-transform: uppercase; }
  .equivariance-proof strong { font-size: 0.82rem; font-weight: 570; }
  .equivariance-proof b { color: var(--flow-accent); font-weight: 450; }
  .equivariance-proof .final-value { color: var(--flow-accent); }
  .equivariance-proof sup { font-size: 0.62em; }

  .physics-figure > figcaption {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  @media (max-width: 42rem) {
    .scale-diagram,
    .symmetry-diagram { grid-template-columns: 1fr; }
    .scale-diagram > b,
    .symmetry-diagram > b { justify-self: center; transform: rotate(90deg); }
    .parameter-list { grid-template-columns: repeat(4, 1fr); }
    .mask-diagram { gap: 0.35rem; }
    .mask-diagram figcaption { font-size: 0.44rem; }
    .orientation-set { width: min(100%, 16rem); justify-self: center; }
    .shared-model,
    .averaged-field { width: min(100%, 11rem); justify-self: center; }
    .equivariance-proof { grid-template-columns: 1fr auto; }
    .equivariance-proof span { grid-column: 1 / -1; }
  }
</style>
