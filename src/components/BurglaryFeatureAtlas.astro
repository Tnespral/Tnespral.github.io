---
const groups = [
  {
    name: "Calendar",
    detail: "position in the year",
    maps: [
      ["month-sin.png", "Month sine"],
      ["month-cos.png", "Month cosine"],
    ],
  },
  {
    name: "Recent activity",
    detail: "what happened nearby",
    maps: [
      ["previous-month.png", "Previous month"],
      ["three-month-mean.png", "Three-month mean"],
      ["neighbour-activity.png", "Neighbouring activity"],
    ],
  },
  {
    name: "Weather",
    detail: "conditions that month",
    maps: [
      ["temperature.png", "Mean temperature"],
      ["rainfall.png", "Rainfall"],
      ["daylight.png", "Daylight"],
    ],
  },
  {
    name: "Neighbourhood",
    detail: "slower local context",
    maps: [
      ["households.png", "Households"],
      ["deprivation.png", "Deprivation"],
      ["house-price.png", "House price"],
      ["young-share.png", "Young resident share"],
    ],
  },
];
---

<figure class="feature-atlas">
  <figcaption class="atlas-heading">
    <strong>All 12 input channels</strong>
    <span class="mono">FEBRUARY 2025</span>
  </figcaption>

  <div class="group-grid">
    {groups.map((group, groupIndex) => (
      <section class="channel-group" aria-labelledby={`channel-group-${groupIndex}`}>
        <header>
          <span class="mono">{String(groupIndex + 1).padStart(2, "0")}</span>
          <div>
            <h3 id={`channel-group-${groupIndex}`}>{group.name}</h3>
            <p>{group.detail}</p>
          </div>
        </header>

        <div class="map-stack">
          {group.maps.map(([image, label]) => (
            <article class="map-card">
              <img
                src={`/figures/burglary/inputs/${image}`}
                alt={`${label} across the prepared London grid in February 2025`}
                width="784"
                height="688"
                loading="lazy"
              />
              <strong>{label}</strong>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <div class="sequence-summary" aria-label="Twelve maps per month across three months gives thirty-six maps in one model input sequence">
    <div class="monthly-tensor">
      <div class="summary-main">
        <span class="layer-stack" aria-hidden="true"><i></i><i></i><b>12</b></span>
        <strong>maps per month</strong>
      </div>
      <small>12 × 86 × 98</small>
    </div>
    <span class="operator mono" aria-hidden="true">×</span>
    <div class="month-sequence">
      <div class="summary-main"><span>Dec</span><span>Jan</span><span>Feb</span></div>
      <small>three consecutive months</small>
    </div>
    <span class="operator mono" aria-hidden="true">=</span>
    <p class="sequence-total"><strong>36 spatial maps</strong><small>one forecast sequence</small></p>
  </div>
</figure>

<style>
  .feature-atlas {
    margin: 1.35rem 0 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 74%, var(--background));
  }

  .atlas-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 0.82rem;
    border-bottom: 1px solid var(--border);
  }

  .atlas-heading strong { font-size: 0.72rem; font-weight: 650; }
  .atlas-heading span { color: var(--muted); font-size: 0.52rem; }

  .group-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .channel-group {
    min-width: 0;
    padding: 0.72rem;
  }

  .channel-group + .channel-group { border-left: 1px solid var(--border); }

  .channel-group header {
    display: flex;
    align-items: flex-start;
    gap: 0.48rem;
    min-height: 2.45rem;
    margin-bottom: 0.55rem;
  }

  .channel-group header > span {
    color: var(--page-accent);
    font-size: 0.5rem;
    line-height: 1.35;
  }

  .channel-group h3 {
    margin: 0;
    font-size: 0.65rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .channel-group p {
    margin: 0.12rem 0 0;
    color: var(--muted);
    font-size: 0.5rem;
    line-height: 1.3;
  }

  .map-stack { display: grid; gap: 0.48rem; }

  .map-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.58rem;
    background: var(--background);
  }

  .map-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 98 / 86;
    object-fit: cover;
    background: #0b1311;
    transition: filter 180ms ease;
  }
  :global(:root[data-theme="dark"]) .map-card img { filter: brightness(1.14) saturate(0.88) contrast(0.96); }

  .map-card strong {
    display: block;
    padding: 0.4rem 0.5rem 0.44rem;
    border-top: 1px solid var(--border);
    font-size: 0.55rem;
    font-weight: 610;
    line-height: 1.25;
  }

  .sequence-summary {
    display: grid;
    grid-template-columns: auto auto minmax(8.5rem, 1fr) auto auto;
    align-items: start;
    gap: 0.78rem;
    padding: 0.8rem;
    border-top: 1px solid var(--border);
  }

  .monthly-tensor, .month-sequence, .sequence-total { display: grid; grid-template-rows: 2.15rem auto; gap: 0.2rem; margin: 0; }
  .summary-main { display: flex; min-height: 2.15rem; align-items: center; }
  .monthly-tensor .summary-main { gap: 0.58rem; }
  .monthly-tensor strong, .sequence-total strong { font-size: 0.59rem; font-weight: 630; }
  .monthly-tensor small, .sequence-total small, .month-sequence small { color: var(--muted); font-size: 0.46rem; }
  .monthly-tensor > small { padding-left: 2.73rem; }
  .sequence-total { align-items: center; }

  .layer-stack {
    position: relative;
    display: block;
    width: 2.4rem;
    height: 2.05rem;
  }
  .layer-stack i,
  .layer-stack b {
    position: absolute;
    display: grid;
    width: 2.05rem;
    height: 1.68rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 0.32rem;
    background: var(--surface);
  }
  .layer-stack i:first-child { top: 0; left: 0.32rem; }
  .layer-stack i:nth-child(2) { top: 0.16rem; left: 0.16rem; }
  .layer-stack b { top: 0.32rem; left: 0; border-color: color-mix(in srgb, var(--page-accent) 46%, var(--border)); background: var(--background); color: var(--page-accent); font-family: "IBM Plex Mono Variable", monospace; font-size: 0.62rem; font-weight: 560; }

  .operator { align-self: center; margin-bottom: 0.66rem; color: var(--page-accent); font-size: 0.65rem; }
  .month-sequence .summary-main { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.22rem; }
  .month-sequence .summary-main span { padding: 0.35rem 0.24rem; border: 1px solid var(--border); border-radius: 0.28rem; background: color-mix(in srgb, var(--page-accent) 8%, var(--surface)); font-family: "IBM Plex Mono Variable", monospace; font-size: 0.47rem; text-align: center; }
  .month-sequence small { text-align: center; }

  @media (max-width: 46rem) {
    .group-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .channel-group:nth-child(3) { border-top: 1px solid var(--border); border-left: 0; }
    .channel-group:nth-child(4) { border-top: 1px solid var(--border); }
  }

  @media (max-width: 36rem) {
    .sequence-summary { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .operator { margin: 0; transform: rotate(90deg); }
    .monthly-tensor > small { padding-left: 0; }
  }

  @media (max-width: 26rem) {
    .group-grid { grid-template-columns: 1fr; }
    .channel-group + .channel-group { border-top: 1px solid var(--border); border-left: 0; }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .map-card img { filter: brightness(1.14) saturate(0.88) contrast(0.96); }
  }
</style>
