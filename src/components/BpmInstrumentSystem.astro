    width: 1.5rem;
    height: 2.05rem;
    border: 1.35px solid var(--ocean);
    border-top: 0;
    border-radius: 0 0 0.46rem 0.46rem;
    box-shadow: none;
  }
  .sample-icon::before {
    position: absolute;
    top: -0.14rem;
    left: -1.35px;
