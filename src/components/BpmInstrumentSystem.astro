    --tube-width: 2px;
    --branch-tube-width: 2.2px;
    --tube-overlap: 2px;
    --waste-tube: color-mix(in srgb, var(--page-accent) 74%, var(--border));
    display: grid;
    grid-template-columns:
      4rem minmax(1.1rem, 0.7fr) 3.25rem minmax(12rem, 2.6fr)
      3.25rem 4.5rem minmax(1.1rem, 0.7fr) 4rem;
    grid-template-rows: 3rem 0.65rem 2.4rem 0.65rem 2.4rem;
    align-items: center;
    min-width: 36rem;
    padding: 1.35rem 1.2rem 0.8rem;
    background: color-mix(in srgb, var(--background) 32%, transparent);
  }

  .node {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    color: var(--foreground);
    text-align: center;
  }

  .node strong,
  .flow-cell-node strong,
  .waste-route strong {
    padding-inline: 0.16rem;
    background: color-mix(in srgb, var(--background) 92%, transparent);
    color: var(--foreground);
    font-size: 0.58rem;
    font-weight: 620;
    line-height: 1.15;
    white-space: nowrap;
  }

  .camera-node {
    grid-column: 4;
    grid-row: 1;
    align-self: center;
    justify-self: center;
    width: fit-content;
  }
  .frames-node { align-self: center; flex: 0 0 auto; }
  .sample-node { grid-column: 1; grid-row: 4; justify-self: end; }
  .pump-node { grid-column: 6; grid-row: 4; }
  .bin-node { grid-column: 8; grid-row: 4; justify-self: start; }
  .illuminator-node {
    grid-column: 4;
    grid-row: 4;
    align-self: center;
    justify-self: center;
  }

  .frames-node strong {
    position: absolute;
    bottom: calc(100% + 0.18rem);
  }
  .camera-node strong {
    position: absolute;
    bottom: calc(100% + 0.18rem);
  }
  .sample-node strong,
  .bin-node strong { position: absolute; top: calc(100% + 0.28rem); }
  .sample-node small {
    position: absolute;
    top: calc(100% + 0.98rem);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.46rem;
    line-height: 1;
    white-space: nowrap;
  }
  .pump-node strong { position: absolute; top: calc(100% + 0.28rem); }
  .illuminator-node strong {
    position: absolute;
    top: 50%;
