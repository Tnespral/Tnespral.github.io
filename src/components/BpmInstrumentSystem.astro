    width: calc(100% + 2.7px);
    height: 0.3rem;
    border: 1.35px solid var(--ocean);
    border-radius: 50%;
    background: var(--background);
    content: "";
  }
  .sample-icon i { position: absolute; right: 0.13rem; bottom: 0.13rem; left: 0.13rem; height: 44%; border-radius: 0.04rem 0.04rem 0.34rem 0.34rem; background: color-mix(in srgb, var(--ocean) 19%, var(--surface)); }

  .flow-cell-icon { grid-row: 2; align-self: center; width: 5.15rem; height: 1.35rem; border: 1.35px solid var(--ocean); border-radius: 0.36rem; }
  .flow-cell-icon i { position: absolute; top: 50%; right: 0.4rem; left: 0.4rem; height: 0.35rem; border-block: 1px solid var(--ocean); transform: translateY(-50%); }
  .flow-cell-icon b { position: absolute; top: 50%; left: 50%; width: 0.7rem; aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--page-accent) 66%, var(--border)); border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--page-accent) 36%, var(--surface)) 0 0.09rem, transparent 0.11rem); transform: translate(-50%, -50%); }

  .pump-icon { width: 3.8rem; height: 3.8rem; border: 1.35px solid var(--ocean); border-radius: 0.56rem; }
  .pump-icon::before,
  .pump-icon::after { position: absolute; top: 50%; width: 0.38rem; aspect-ratio: 1; border: 1.25px solid var(--ocean); border-radius: 50%; background: var(--background); content: ""; transform: translateY(-50%); }
  .pump-icon::before { left: -0.23rem; }
  .pump-icon::after { right: -0.23rem; }
  .syringe { position: absolute; top: -0.76rem; left: 50%; width: 0.7rem; height: 1.42rem; border: 1.2px solid var(--ocean); border-radius: 0.15rem; background: var(--background); transform: translateX(-50%); }
  .syringe::before { position: absolute; top: -0.26rem; left: 50%; width: 1.08rem; height: 0.22rem; border: 1.15px solid var(--ocean); border-radius: 0.08rem; background: var(--background); content: ""; transform: translateX(-50%); }
  .syringe b { position: absolute; right: 0.09rem; bottom: 0.09rem; left: 0.09rem; height: 48%; background: color-mix(in srgb, var(--ocean) 17%, var(--surface)); }
  .valve { position: absolute; top: 54%; left: 50%; width: 2.3rem; aspect-ratio: 1; border: 1.2px solid var(--ocean); border-radius: 50%; transform: translate(-50%, -45%); }
  .valve::before { position: absolute; top: 50%; left: 50%; width: 0.62rem; aspect-ratio: 1; border: 1.1px solid var(--ocean); border-radius: 50%; content: ""; transform: translate(-50%, -50%); }
