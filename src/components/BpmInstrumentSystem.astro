    grid-column: 2 / 5;
    grid-row: 3 / 6;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    align-self: stretch;
  }

  .network-trunk,
  .network-upper-run,
  .network-lower-run,
  .network-split::before,
  .network-split::after {
    display: block;
    height: var(--tube-width);
    border-radius: 999px;
    background: var(--ocean);
    content: "";
  }

  .network-trunk {
    position: relative;
    z-index: 3;
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    width: calc(100% + var(--tube-overlap) + var(--tube-overlap));
    margin-left: calc(0px - var(--tube-overlap));
  }

  .network-split {
    position: relative;
    grid-column: 2;
    grid-row: 1 / 4;
    align-self: stretch;
  }

  /*
    The split column is 3.25rem wide and each route centre is 1.525rem
    from the trunk centre. Both branches are therefore sqrt(3.25^2 +
    1.525^2) = 3.59rem long at equal and opposite 25.13deg angles.
  */
  .network-split::before,
  .network-split::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 3.59rem;
    height: var(--branch-tube-width);
    transform-origin: left center;
  }
  .network-split::before {
    z-index: 2;
    transform: translateY(-50%) rotate(-25.13deg);
  }
  .network-split::after {
    z-index: 1;
    background: var(--waste-tube);
    transform: translateY(-50%) rotate(25.13deg);
  }

  .network-upper-run,
  .network-lower-run {
    grid-column: 3;
    align-self: center;
    width: calc(100% + var(--tube-overlap) + var(--tube-overlap));
    margin-left: calc(0px - var(--tube-overlap));
  }
  .network-upper-run {
    position: relative;
    z-index: 3;
    grid-row: 1;
  }
  .network-lower-run {
    position: relative;
    z-index: 1;
    grid-row: 3;
    background: var(--waste-tube);
  }

  .right-network {
    position: relative;
    z-index: 1;
    display: grid;
    grid-column: 5 / 8;
    grid-row: 3 / 6;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    align-self: stretch;
  }

  .network-merge {
    position: relative;
    grid-column: 1;
    grid-row: 1 / 4;
    align-self: stretch;
  }

  .network-merge::before,
  .network-merge::after,
  .network-pump-run,
  .network-waste-run {
    display: block;
    height: var(--tube-width);
    border-radius: 999px;
    background: var(--ocean);
    content: "";
  }

  /* The merge repeats the same 3.59rem / 25.13deg geometry in reverse. */
  .network-merge::before,
  .network-merge::after {
    position: absolute;
    left: 0;
    width: 3.59rem;
    height: var(--branch-tube-width);
    transform-origin: left center;
  }
  .network-merge::before {
    z-index: 1;
    top: calc(50% - 1.525rem);
    transform: translateY(-50%) rotate(25.13deg);
  }
  .network-merge::after {
    z-index: 2;
    top: calc(50% + 1.525rem);
    background: var(--waste-tube);
    transform: translateY(-50%) rotate(-25.13deg);
  }

  .network-pump-run,
  .network-waste-run {
    grid-row: 2;
    align-self: center;
    width: calc(100% + var(--tube-overlap) + var(--tube-overlap));
    margin-left: calc(0px - var(--tube-overlap));
  }
  .network-pump-run,
  .network-waste-run {
    position: relative;
    z-index: 3;
    background: var(--waste-tube);
  }
  .network-pump-run { grid-column: 2; }
  .network-waste-run { grid-column: 3; }

  .measurement-route {
    display: grid;
    grid-column: 4;
    grid-row: 3;
    align-self: stretch;
    place-items: center;
  }
  .flow-cell-node {
    position: relative;
    z-index: 4;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .flow-cell-node strong { position: absolute; bottom: calc(100% + 0.28rem); }

  .waste-route {
    position: relative;
    z-index: 2;
    display: grid;
    grid-column: 4;
    grid-row: 5;
    align-items: center;
  }
  .waste-route strong { position: absolute; top: calc(50% + 0.48rem); left: 50%; color: var(--muted); transform: translateX(-50%); }

  .sample-icon,
  .flow-cell-icon,
  .pump-icon,
  .bin-icon,
  .camera-icon,
  .frames-icon,
  .illuminator-icon {
    position: relative;
    display: block;
    background: var(--background);
    box-shadow: 0 0 0 0.24rem color-mix(in srgb, var(--background) 80%, transparent);
  }

  .flow-cell-icon,
  .pump-icon,
  .bin-icon { box-shadow: none; }

  .sample-icon {
