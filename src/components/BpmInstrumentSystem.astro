<style>
  .instrument-system {
    margin: 1.45rem 0 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 70%, var(--background));
  }

  .diagram-scroll { overflow-x: auto; overscroll-behavior-inline: contain; }

  .system-map {
